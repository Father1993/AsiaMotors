# Runtime-only web configuration. Real values stay in the ignored .env.
NEXTAUTH_URL=https://asiamotors.su
NEXTAUTH_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# Database and SMTP credentials live in .secrets/ (see DEPLOYMENT.md).

# Outbound email is enabled only after explicit SMTP verification.
MAIL_DELIVERY_ENABLED=false
