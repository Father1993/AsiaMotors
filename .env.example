# Конфигурация Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Конфигурация Supabase (заполните своими значениями)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Другие переменные окружения
NODE_ENV=production
PORT=3000

# Добавьте другие переменные окружения из вашего проекта при необходимости
# Authentication (set real values only in the ignored .env file)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# EmailJS
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_2=your_emailjs_second_template_id
NEXT_PUBLIC_GA_ID=
